{
  "name": "photoprint-platform",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check:tenant-request": "node --experimental-transform-types --no-warnings=ExperimentalWarning scripts/check-no-tenant-in-request.ts",
    "test": "vitest run --project unit",
    "test:tenancy": "vitest run --project tenancy"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.2",
    "@nestjs/core": "^12.0.2",
    "@nestjs/platform-fastify": "^12.0.2",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.222.0",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-logs-otlp-grpc": "^0.222.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.222.0",
    "@opentelemetry/exporter-metrics-otlp-grpc": "^0.222.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-logs": "^0.222.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.4",
    "mysql2": "^3.24.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.1",
    "@nestjs/testing": "^12.0.2",
    "@swc/core": "^1.16.2",
    "@testcontainers/mysql": "^12.1.0",
    "@types/node": "^26.5.1",
    "@vitest/eslint-plugin": "^1.6.27",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "unplugin-swc": "^1.6.0",
    "vitest": "^5.0.0"
  }
}
